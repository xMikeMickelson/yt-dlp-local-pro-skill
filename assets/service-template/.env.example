HOST=127.0.0.1
PORT=5000

DOWNLOAD_DIR=<SERVICE_DIR>/downloads
LOG_DIR=<SERVICE_DIR>/logs

# Netscape cookie files. First line must be: # Netscape HTTP Cookie File
# Instagram needs sessionid. TikTok needs sid_tt. Re-export after a login wall;
# do not keep a jar yt-dlp has invalidated.
YOUTUBE_COOKIES=cookies/youtube.txt
INSTAGRAM_COOKIES=cookies/instagram.txt
TIKTOK_COOKIES=cookies/tiktok.txt
# Optional. When unset, logged-out X/Twitter uses extractor arg api=syndication.
# TWITTER_COOKIES=cookies/twitter.txt

# Optional --cookies-from-browser (used only when that platform has no cookie file).
# On Linux Chromium this needs the optional secretstorage extra; do not require it.
# COOKIES_FROM_BROWSER=chrome

# Must match the browser that exported cookies. Default is reduced Chrome 154
# (stable 154.0.8037.97 verified 2026-10-01). Override if you exported elsewhere.
# USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/154.0.0.0 Safari/537.36

PROXY_HOST=proxy-provider.example.com
PROXY_USER=YOUR_PROXY_USERNAME
PROXY_PASS=YOUR_PROXY_PASSWORD

PROXY_PORT_YOUTUBE=20501
PROXY_PORT_INSTAGRAM=20502
PROXY_PORT_TIKTOK=20503
PROXY_PORT_TWITTER=20504
PROXY_PORT_FACEBOOK=20505
PROXY_PORT_DEFAULT=20506
